{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinOps Vacancy Evidence Record",
  "type": "object",
  "required": ["vacancy_id", "checked_at", "active_status", "title_verified", "malaysia_verified", "job_url", "source"],
  "properties": {
    "vacancy_id": {"type": "string", "pattern": "^MY-FE-[0-9]{4}$"},
    "checked_at": {"type": "string", "format": "date-time"},
    "active_status": {"type": "boolean"},
    "title_verified": {"type": "boolean"},
    "malaysia_verified": {"type": "boolean"},
    "job_url": {"type": "string", "format": "uri"},
    "source": {"type": "string", "minLength": 1},
    "status_evidence": {"type": ["string", "null"]},
    "title_evidence": {"type": ["string", "null"]},
    "location_evidence": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
